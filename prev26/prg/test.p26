fun prefix(a:int, b:bool, p:^int) : int = not b, +a, -a, ^p
fun arith(a:int, b:int, c:int) : int = a * b / c % 2 + a - b
fun comps(a:int, b:int) : bool = a == b, a != b, a < b, a > b, a <= b, a >= b
fun logic(a:bool, b:bool, x:int) : int = a and b or a, x as int, x = y
fun post(a:int) : int = obj.field, ptr^, arr[a], g(a), obj.fld[a]^
