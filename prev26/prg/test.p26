fun iff1(a:bool) : int = if a then 1 end
fun iff2(a:bool) : int = if a then 1 else 2 end
fun wh(a:int) : int = while a do a = a - 1 end

fun letf() : int = let
    typ T = int
    var x : T
    fun h(a:T) : T = a
in
    h(1)
end

