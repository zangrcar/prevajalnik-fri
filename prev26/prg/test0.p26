typ unary = (: int : int)
var global_fun : (: int : int)

fun putint(i : int) : void

fun inc(x : int) : int =
    x + 1

fun choose_inc() : (: int : int) =
    inc

fun main(): int =
	global_fun = inc,
	global_fun = choose_inc(),
	let 
		var a: int
	in
		a = global_fun(5),
		putint(a)
	end,
	global_fun(5)