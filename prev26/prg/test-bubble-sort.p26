fun getint() : int
fun putint(i : int) : void
fun putchar(c : char) : void

var n : int
var i : int
var j : int
var tmp : int
var arr : [100]int
var prompt_i : int

fun printString(s: ^char, length: int): void =
	let
		var n: int
		var a: char
	in
		n = 0,
		while (n < length) do
			a = (((s as int) + n) as ^char)^,
			n = n+1,
			putchar(a)
		end,
		putchar('\x0A')
	end


fun main() : int =
    printString("Input the array length:", 23),
    n = getint(),
    putchar('\x0A'),

    printString("Input the array:", 16),
    i = 0,
    while i < n do
        arr[i] = getint(),
        i = i + 1
    end,
    putchar('\x0A'),

    i = 0,
    while i < n do
        j = 0,
        while j < n - i - 1 do
            if arr[j] > arr[j + 1] then
                tmp = arr[j],
                arr[j] = arr[j + 1],
                arr[j + 1] = tmp
            end,
            j = j + 1
        end,
        i = i + 1
    end,

    i = 0,
    while i < n do
        putint(arr[i]),
        if i < n - 1 then
            putchar('\x20')
        end,
        i = i + 1
    end,
    putchar('\x0A'),
    0
